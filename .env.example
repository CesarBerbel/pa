# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# Nunca faça commit do ".env" real (ele já está no .gitignore).

# =============================================================================
# Core
# =============================================================================

# Gere uma chave própria, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme

DEBUG=True
ENVIRONMENT=development
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
INTERNAL_IPS=127.0.0.1

# Em produção (.env.prod), SITE_URL define o domínio canónico usado nas tags
# canonical, no sitemap, no hreflang e nos links dos emails de marcação.
# ALLOWED_HOSTS tem de listar todos os domínios que chegam ao Django e
# CSRF_TRUSTED_ORIGINS todos eles com esquema, ou os formulários falham.
# Ver docs/deploy.md, secção "Domínio principal e domínios alternativos".

# =============================================================================
# SEO / dados públicos do negócio
# =============================================================================

SEO_SITE_NAME=Priscila Arantes PA
SEO_DEFAULT_TITLE=Pedicure Terapêutica em Coimbra | Tratamentos dos Pés | Pri Arantes
SEO_DEFAULT_DESCRIPTION=Atendimento profissional em pedicure terapêutica, manicure e enfermagem em Coimbra. Consulte serviços e marque o seu horário online.
SEO_DEFAULT_KEYWORDS=pedicure terapêutica Coimbra, tratamento dos pés Coimbra, manicure Coimbra, enfermagem Coimbra, pé diabético, unha encravada, troca de penso
SEO_DEFAULT_IMAGE_PATH=/static/img/logo-og.png
SEO_LOCALE=pt_PT
SEO_THEME_COLOR=#a8755f
SEO_ROBOTS_DEFAULT=index,follow

SEO_WHATSAPP_NUMBER=+351938594367
SEO_BUSINESS_EMAIL=atendimento@priarantes.com
SEO_BUSINESS_STREET_ADDRESS=Av. Sá da Bandeira 33, Loja 108
SEO_BUSINESS_LOCALITY=Coimbra
SEO_BUSINESS_POSTAL_CODE=3000-351
SEO_BUSINESS_COUNTRY=PT
SEO_BUSINESS_AREA_SERVED=Coimbra
SEO_BUSINESS_OPENS_AT=08:00
SEO_BUSINESS_CLOSES_AT=20:00

# =============================================================================
# Homepage pública
# =============================================================================

# Opções: classic | logo_top
HOME_HERO_LAYOUT=logo_top

# =============================================================================
# Livro de Reclamações
# =============================================================================

# Portal oficial para onde a página /livro-de-reclamacoes/ encaminha.
COMPLAINTS_BOOK_URL=https://www.livroreclamacoes.pt/inicio


# =============================================================================
# Instagram
# =============================================================================

# As fotos do carrossel são cadastradas manualmente em Django Admin
# (Notifications > Publicações do Instagram) — não há integração automática.
# Link do botão "Seguir no Instagram" (opcional).
INSTAGRAM_PROFILE_URL=https://www.instagram.com/priarantespod

# =============================================================================
# Registos clínicos
# =============================================================================

# Prazo de conservação das fichas de anamnese, em anos. 0 = por definir.
# Tem de ser decidido pela responsável; ver docs/deploy.md.
CLINICAL_RECORD_RETENTION_YEARS=0

# =============================================================================
# Marcações públicas
# =============================================================================

PUBLIC_BOOKING_MIN_ADVANCE_HOURS=3

# =============================================================================
# Banco de dados (deixe como está para usar SQLite em desenvolvimento local)
# =============================================================================

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Usados apenas quando DB_ENGINE não é sqlite3 (ex: postgresql):
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# =============================================================================
# Senhas
# =============================================================================

PASSWORD_MIN_LENGTH=8

# =============================================================================
# Localização
# =============================================================================

LANGUAGE_CODE=pt-pt
TIME_ZONE=Europe/Lisbon
PUBLIC_BOOKING_TIME_ZONE=Europe/Lisbon

# =============================================================================
# Arquivos estáticos e mídia
# =============================================================================

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# =============================================================================
# Segurança (defaults seguros já aplicados quando DEBUG=False)
# =============================================================================

SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=False
USE_X_FORWARDED_HOST=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# =============================================================================
# Email
# =============================================================================

# Em desenvolvimento, mantenha o backend de console (imprime o email no terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Em produção, use por exemplo: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
SERVER_EMAIL=webmaster@localhost
EMAIL_TIMEOUT=30

# =============================================================================
# WhatsApp Cloud API (notificações automáticas de marcação)
# =============================================================================

WHATSAPP_CLOUD_API_ENABLED=False
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=marcacao
WHATSAPP_TEMPLATE_LANGUAGE_CODE=pt_PT
WHATSAPP_TEMPLATE_BODY_PARAMETERS=customer_name,service_name,appointment_date,appointment_time,reference_code
WHATSAPP_REQUEST_TIMEOUT=15

# -----------------------------------------------------------------------------
# Twilio (WhatsApp)
# -----------------------------------------------------------------------------
# Alternativa ao Cloud API acima; as duas podem coexistir.
# TWILIO_WHATSAPP_FROM tem de vir no formato whatsapp:+numero.
# O do sandbox e whatsapp:+14155238886.
TWILIO_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Para onde vao os avisos dirigidos a profissional. Por omissao usa o
# SEO_WHATSAPP_NUMBER.
TWILIO_PROFESSIONAL_WHATSAPP=
TWILIO_REQUEST_TIMEOUT=15

# -----------------------------------------------------------------------------
# Baileys (WhatsApp)
# -----------------------------------------------------------------------------
# Liga o numero da clinica como um dispositivo, a maneira do WhatsApp Web:
# texto livre sempre, sem modelos para aprovar e sem custo por mensagem, mas
# sem garantia de servico. Corre no container `baileys` do docker-compose.
#
# Cada regra de mensagem escolhe se sai por aqui ou pela Twilio, no ecra
# Configuracoes > WhatsApp. Ligar as duas nao duplica envios.
BAILEYS_ENABLED=False

# Nome do servico na rede interna do Docker. Em desenvolvimento, com o
# servico a correr a mao fora do compose, use http://localhost:3000
BAILEYS_API_URL=http://baileys:3000

# Segredo partilhado entre o Django e o servico Node. Tem de ser o mesmo valor
# dos dois lados. Gere um com: openssl rand -hex 32
BAILEYS_API_TOKEN=

# Para onde vao os avisos dirigidos a profissional. Por omissao segue o
# TWILIO_PROFESSIONAL_WHATSAPP.
BAILEYS_PROFESSIONAL_WHATSAPP=

BAILEYS_REQUEST_TIMEOUT=20

# Nome que aparece no telemovel em Definicoes > Dispositivos ligados.
BAILEYS_DEVICE_NAME=Priscila Arantes PA

# Verbosidade do servico Node: trace | debug | info | warn | error
BAILEYS_LOG_LEVEL=info

# =============================================================================
# Logging
# =============================================================================

# Opções: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Entrega de notificações
# =============================================================================

# Emails e mensagens de WhatsApp saem em threads separadas, para quem marca não
# esperar pelo SMTP nem pelo WhatsApp. Desligue para voltar a enviar dentro do
# pedido (útil para depurar um envio que falha). Debaixo dos testes é
# sempre imediato, independentemente do que aqui estiver.
# Quanto tempo o browser guarda um ficheiro estático, em segundos.
# O endereço leva a data do ficheiro, portanto um ano é seguro.
WHITENOISE_MAX_AGE=31536000

NOTIFICATIONS_IN_BACKGROUND=True

# Quantas entregas podem estar a decorrer ao mesmo tempo.
NOTIFICATIONS_MAX_WORKERS=4

# =============================================================================
# Avaliações do Google
# =============================================================================

# Chave da Places API (nova) e identificador do local. Sem os dois, a secção de
# avaliações não aparece na página inicial.
#
# A chave cria-se em console.cloud.google.com com a "Places API (New)" ligada,
# e deve ser restringida a este domínio. O identificador do local encontra-se
# no Place ID Finder da Google.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
